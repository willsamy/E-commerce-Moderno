# ------------------------------
# App
# ------------------------------
NODE_ENV=production
APP_BASE_URL=https://your-app-name.vercel.app

# ------------------------------
# Database (Production - Vercel Postgres ou PlanetScale)
# ------------------------------
# Para Vercel Postgres:
# DATABASE_URL=postgres://username:password@host:port/database?sslmode=require
# Para PlanetScale:
# DATABASE_URL=mysql://username:password@host:port/database?sslaccept=strict
DATABASE_URL=your_production_database_url

# ------------------------------
# NextAuth
# ------------------------------
NEXTAUTH_URL=https://your-app-name.vercel.app
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-for-production

# ------------------------------
# Stripe (Production)
# Generate from https://dashboard.stripe.com/apikeys
# ------------------------------
STRIPE_PUBLIC_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
# Configure webhook endpoint in Stripe Dashboard: https://your-app-name.vercel.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_endpoint_secret

# ------------------------------
# Vercel Specific (Optional)
# ------------------------------
# VERCEL=1
# VERCEL_URL=your-app-name.vercel.app
# VERCEL_ENV=production